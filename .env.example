# Copy this file to .env and fill in your real values.

# NEVER commit a real .env file. It must stay in .gitignore.

# Required for the AutoGen Clinician Chat agent (app/agents/autogen_team.py)

# and the LLM Explanation agent (app/agents/llm_explanation_agent.py).

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional. If unset, falls back to AZURE_OPENAI_DEPLOYMENT.

AZURE_OPENAI_MODEL=gpt-chat-latest

# Local Streamlit frontend only for now.

# Add your deployed frontend URL later if/when you have one.

CORS_ALLOWED_ORIGINS=[http://localhost:8501,http://127.0.0.1:8501](http://localhost:8501,http://127.0.0.1:8501)

# Optional. Controls the provisional Manchester-style research ruleset.

PROVISIONAL_MTS_MODE=on
# Runtime serves the packaged curated 100-case demonstration. The full offline
# training cohort is excluded from Azure packages and is not read in this mode.
UHL_CASE_COHORT=demo_100
